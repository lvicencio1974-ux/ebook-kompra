# Copia este archivo a .env y completa los valores antes de correr el servidor.

# Base de datos SQLite local (no requiere infraestructura externa)
DATABASE_URL="file:./dev.db"

# Secreto para firmar los JWT de sesion. Genera uno propio, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-un-valor-aleatorio-largo"

# Clave de 32 bytes (64 caracteres hex) para cifrar archivos multimedia en reposo (AES-256-GCM).
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_ENCRYPTION_KEY="cambia-esto-por-64-caracteres-hexadecimales"

# Opcional: habilita el asistente conversacional generativo (Claude).
# Sin esta clave, el chat usa el buscador local por palabras clave como respaldo seguro.
ANTHROPIC_API_KEY=""

# Dias de espera tras la segunda confirmacion de fallecimiento antes de desbloquear
# automaticamente el modo conversacional (ventana de seguridad para cancelar por error o fraude).
DEATH_VERIFICATION_GRACE_DAYS=7

# Opcional: claves para activar los proveedores de voz/avatar en el futuro (dejar vacias por ahora).
ELEVENLABS_API_KEY=""
HEYGEN_API_KEY=""

PORT=4000
